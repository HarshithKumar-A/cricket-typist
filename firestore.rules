rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function validEntry(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'score', 'wickets',
          'accuracy', 'wpm', 'fours', 'sixes', 'updatedAt'
        ])
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.wickets is int
        && request.resource.data.wickets >= 0
        && request.resource.data.wickets <= 10
        && request.resource.data.accuracy is number
        && request.resource.data.accuracy >= 0
        && request.resource.data.accuracy <= 100
        && request.resource.data.wpm is number
        && request.resource.data.wpm >= 0
        && request.resource.data.fours is int
        && request.resource.data.fours >= 0
        && request.resource.data.sixes is int
        && request.resource.data.sixes >= 0
        && request.resource.data.updatedAt is timestamp;
    }

    match /leaderboards/{boardId}/entries/{userId} {
      allow read: if isSignedInUser();
      allow create: if isSignedInUser()
        && request.auth.uid == userId
        && validEntry(userId);
      allow update: if isSignedInUser()
        && request.auth.uid == userId
        && validEntry(userId)
        && request.resource.data.score is int
        && request.resource.data.score >= resource.data.score;
      allow delete: if isSignedInUser() && request.auth.uid == userId;
    }
  }
}
